[
  {
    "label": "Yazi (current file)",
    "command": "yazi $ZED_FILE --chooser-file /tmp/yazi-path-zed && [ -s /tmp/yazi-path-zed ] && zed $(cat /tmp/yazi-path-zed)",
    "shell": {
      "program": "sh"
    },
    "reveal": "always",
    "hide": "always",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "Yazi (project root)",
    "command": "yazi $ZED_WORKTREE_ROOT --chooser-file /tmp/yazi-path-zed && [ -s /tmp/yazi-path-zed ] && zed $(cat /tmp/yazi-path-zed)",
    "shell": {
      "program": "sh"
    },
    "reveal": "always",
    "hide": "always",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "lazygit",
    "command": "lazygit",
    "shell": {
      "program": "sh"
    },
    "reveal": "always",
    "hide": "always",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  }
